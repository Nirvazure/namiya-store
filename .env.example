# YQYHub: same Supabase Auth project as RapperRank / ArtMind.
SUPABASE_URL=https://tfvzcuksahcofooqqezx.supabase.co
SUPABASE_KEY=
# Server only. Never use NEXT_PUBLIC_ for this key.
SUPABASE_SERVICE_ROLE_KEY=

# Both URLs must target namiya_store. Replace USER/PASSWORD/HOST locally.
# Runtime: transaction pooler 6543, with pgbouncer=true.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&sslmode=require&schema=namiya_store
# Migrations: session pooler 5432.
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require&schema=namiya_store

NAMIYA_PRIVATE_BUCKET=namiya-private
NAMIYA_PUBLIC_BUCKET=namiya-scenes

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=sage

NEXT_PUBLIC_SITE_URL=http://localhost:3000
